{
  "name": "hoodai",
  "displayName": "hoodAI",
  "description": "Shows a sponsored ad (image, text, link) in your editor while you work, and pays you a share of the revenue.",
  "version": "0.1.1",
  "publisher": "hoodai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hoodai.showAd",
        "title": "hoodAI: Show Sponsored Panel"
      },
      {
        "command": "hoodai.showEarnings",
        "title": "hoodAI: Show My Earnings"
      }
    ],
    "contributes": {
        "configuration": {
            "title": "HoodAI",
                "properties": {
                      "hoodai.apiToken": {
                              "type": "string",
                                      "default": "",
                                              "description": "Paste your HoodAI API Token from your dashboard."
                                                    },
                                                          "hoodai.refreshIntervalSeconds": {
                                                                  "type": "number",
                                                                          "default": 60,
                                                                                  "minimum": 15,
                                                                                          "description": "Refresh ads every N seconds."
                                                                                                },
                                                                                                      "hoodai.enabled": {
                                                                                                              "type": "boolean",
                                                                                                                      "default": true,
                                                                                                                              "description": "Enable HoodAI sponsored ads."
                                                                                                                                    }
                                                                                                                                        }
                                                                                                                                          }
                                                                                                                                          }
    },
    
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@idlen/chat-sdk": "^1.0.5"
  }
}
