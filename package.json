{
  "name": "hoodai",
  "displayName": "HoodAI",
  "description": "Shows sponsored developer cards inside VS Code while AI tools are waiting.",
  "version": "0.2.5",
  "publisher": "hoodai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sir8766666-alt/HoodAI.git"
  },
  "homepage": "https://github.com/sir8766666-alt/HoodAI",
  "bugs": {
    "url": "https://github.com/sir8766666-alt/HoodAI/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ads",
    "sponsored",
    "developer",
    "ai",
    "hoodai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hoodai.showAd",
        "title": "HoodAI: Show Sponsored Ad"
      },
      {
        "command": "hoodai.showEarnings",
        "title": "HoodAI: Show Earnings"
      }
    ],
    "configuration": {
      "title": "HoodAI",
      "properties": {
        "hoodai.apiToken": {
          "type": "string",
          "default": "",
          "description": "Paste your HoodAI API Token."
        },
        "hoodai.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "Refresh sponsored cards every N seconds."
        },
        "hoodai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable HoodAI sponsored cards."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
