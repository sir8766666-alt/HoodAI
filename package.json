{
  "name": "hoodai",
  "displayName": "HoodAI",
  "description": "HoodAI detects AI coding activity in VS Code and displays sponsored content while AI is working.",
  "version": "3.0.1",
  "publisher": "hoodai",
  "license": "MIT",
  "author": {
    "name": "HoodAI"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sir876666-alt/HoodAI.git"
  },
  "bugs": {
    "url": "https://github.com/sir876666-alt/HoodAI/issues"
  },
  "homepage": "https://hoodai-zscw.onrender.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "ai-coding",
    "developer-tools",
    "ads"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hoodai.open",
    "onCommand:hoodai.showAd",
    "onCommand:hoodai.showEarnings",
    "onCommand:hoodai.openSettings",
    "onCommand:hoodai.checkToken",
    "onCommand:hoodai.showOutput"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "package:vsix": "vsce package",
    "clean": "rm -rf out *.vsix",
    "check": "npm run compile",
    "prepublishOnly": "npm run compile"
  },
  "contributes": {
    "commands": [
      {
        "command": "hoodai.open",
        "title": "HoodAI: Open"
      },
      {
        "command": "hoodai.showAd",
        "title": "HoodAI: Show Ad"
      },
      {
        "command": "hoodai.showEarnings",
        "title": "HoodAI: Show Earnings"
      },
      {
        "command": "hoodai.openSettings",
        "title": "HoodAI: Open Settings"
      },
      {
        "command": "hoodai.checkToken",
        "title": "HoodAI: Check API Token"
      },
      {
        "command": "hoodai.showOutput",
        "title": "HoodAI: Show Output"
      }
    ],
    "configuration": {
      "title": "HoodAI",
      "properties": {
        "hoodai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable HoodAI AI activity detection and sponsored content."
        },
        "hoodai.apiToken": {
          "type": "string",
          "default": "",
          "description": "Your HoodAI API token.",
          "scope": "machine"
        },
        "hoodai.apiBase": {
          "type": "string",
          "default": "https://hoodai-zscw.onrender.com",
          "description": "HoodAI backend URL."
        },
        "hoodai.detectorInterval": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "description": "How often HoodAI checks AI activity state, in milliseconds."
        },
        "hoodai.showAds": {
          "type": "boolean",
          "default": true,
          "description": "Show sponsored content while an AI assistant is working."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
