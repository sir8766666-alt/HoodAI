{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/HoodAI/.claude/hooks/hoodai-state.sh thinking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/HoodAI/.claude/hooks/hoodai-state.sh idle"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/HoodAI/.claude/hooks/hoodai-state.sh idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/HoodAI/.claude/hooks/hoodai-state.sh idle"
          }
        ]
      }
    ]
  }
}
